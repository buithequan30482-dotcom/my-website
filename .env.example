# =============================================================================
# CẤU HÌNH TRIỂN KHAI – Website di tích Đặc khu Vân Đồn
# Sao chép thành ./.env (deploy/scripts/first-run.sh tự làm và sinh bí mật ngẫu nhiên).
# KHÔNG đưa tệp .env lên git / gửi qua chat. Quyền tệp: chmod 600 .env
# Định dạng: KEY=giá_trị (không dấu cách quanh "=", không cần ngoặc kép).
# =============================================================================

# ---------------------------------------------------------------- Tên miền ---
# Tên miền chính của website (Chủ đầu tư cung cấp – TR 8.4)
DOMAIN=example.gov.vn
# Tên miền phụ chuyển hướng về tên miền chính, cách nhau dấu cách (vd: www.example.gov.vn). Để trống nếu không có.
EXTRA_DOMAINS=
# Email nhận thông báo của Let's Encrypt (chứng chỉ sắp hết hạn)
LETSENCRYPT_EMAIL=
# auto = tự bật HTTPS khi đã có chứng chỉ; off = chỉ HTTP (thử nghiệm nội bộ); on = bắt buộc HTTPS
NGINX_SSL=auto
# Cổng công khai trên VPS (đổi khi chạy thử, vd 8080/8443)
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------ Django ---
# Khóa bí mật – chuỗi ngẫu nhiên ≥50 ký tự (first-run.sh tự sinh). Đổi khóa = mọi phiên đăng nhập bị hủy.
DJANGO_SECRET_KEY=CHANGE_ME
# Luôn 0 trên máy chủ thật (1 = hiện thông tin lỗi chi tiết, KHÔNG an toàn)
DJANGO_DEBUG=0
# Tên miền được phép truy cập, cách nhau dấu phẩy
DJANGO_ALLOWED_HOSTS=example.gov.vn
# Nguồn tin cậy cho CSRF (có https://), cách nhau dấu phẩy
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.gov.vn
# 1 = bật cookie Secure, chuyển hướng HTTPS, HSTS (đặt 1 trên máy chủ thật; 0 khi thử nghiệm HTTP)
DJANGO_HTTPS=1
# Đường dẫn bí mật khu quản trị (TR 3.2 – không dùng /admin/). Dạng "ten-duong-dan/". first-run.sh sinh ngẫu nhiên.
ADMIN_URL=quan-tri-vd/
# Bắt buộc xác thực 2 lớp (OTP) cho quản trị hệ thống: 1 = bật (bắt buộc trên máy chủ thật)
OTP_REQUIRED_FOR_SUPERUSER=1
# Số lần gửi đánh giá/góp ý tối đa mỗi giờ cho 1 người dùng (TR FR-I06)
SUBMIT_RATE_LIMIT_PER_HOUR=5
# Mức ghi nhật ký: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Email nhận cảnh báo lỗi 500 (TR 8.5), dạng "Tên <email>" hoặc email, cách nhau dấu phẩy. Cần cấu hình SMTP bên dưới.
DJANGO_ADMINS=

# 1 = khi container web khởi động mà CSDL chưa có di tích thì tự nạp 44 di tích (load_vandon).
# Mặc định 0 vì deploy/scripts/first-run.sh đã chạy load_vandon tường minh.
AUTO_SEED=0
# 1 = tự chạy migrate khi container web khởi động
RUN_MIGRATIONS=1

# --------------------------------------------------------------- Gunicorn ---
# Số tiến trình xử lý. Để trống = 2 × số CPU + 1 (VPS 2 vCPU -> 5). Giảm còn 3 nếu RAM thiếu.
GUNICORN_WORKERS=
# Số luồng mỗi tiến trình (1 = worker sync)
GUNICORN_THREADS=1
# Giây tối đa cho 1 yêu cầu trước khi tiến trình bị khởi động lại
GUNICORN_TIMEOUT=60

# ------------------------------------------------------------ PostgreSQL ---
POSTGRES_DB=vandon
POSTGRES_USER=vandon
# Mật khẩu CSDL – chỉ chữ và số (first-run.sh tự sinh). Không đổi sau khi CSDL đã khởi tạo
# (muốn đổi: ALTER USER trong psql rồi mới sửa ở đây).
POSTGRES_PASSWORD=CHANGE_ME
# Để trống: tự ghép postgres://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
DATABASE_URL=

# ------------------------------------------------------------------ Redis ---
# Để trống: redis://redis:6379/0 (container redis trong compose)
REDIS_URL=

# ------------------------------------------------------------------ Media ---
# Thư mục lưu ảnh/video trong container (gắn volume "media"). Không cần đổi.
MEDIA_ROOT=/srv/media

# ------------------------------------------------------------------ Email ---
# Hộp thư SMTP của cơ quan (TR 8.4) – dùng cho thông báo kiểm duyệt, đặt lại mật khẩu.
# Chưa có SMTP: giữ console backend (thư chỉ ghi ra nhật ký container web).
# Có SMTP: đổi thành django.core.mail.backends.smtp.EmailBackend và điền các dòng dưới.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 1 = STARTTLS (cổng 587)
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@example.gov.vn

# -------------------------------------------------------------- Bản đồ ---
# Khóa Google Maps (Maps JavaScript API, Maps Embed API, Places API) – giới hạn HTTP referrer theo DOMAIN.
# Để trống: website tự dùng bản đồ OpenStreetMap. Có thể nhập trong khu quản trị (Cấu hình hệ thống) thay vì ở đây.
GOOGLE_MAPS_API_KEY=

# --------------------------------------------------------------- Sao lưu ---
# Lịch cron (giờ Việt Nam): mặc định 02:00 hằng ngày (CSDL + media gia tăng; media đầy đủ vào MEDIA_FULL_WEEKDAY)
BACKUP_CRON=0 2 * * *
# Số bản sao lưu CSDL giữ lại trên VPS (TR 8.3: 30 bản)
BACKUP_KEEP_DAYS=30
# Ngày tạo bản media ĐẦY ĐỦ trong tuần: 1=Thứ Hai ... 7=Chủ nhật (các ngày khác: gia tăng)
MEDIA_FULL_WEEKDAY=7
# Số tuần bản media (đầy đủ + gia tăng) giữ trên VPS
MEDIA_KEEP_WEEKS=5
# Kho lưu trữ NGOÀI VPS qua rclone (TR 8.3 bắt buộc lưu ra ngoài), dạng "<tên remote>:<thư mục>"
# vd: s3vandon:vandon-backup   (khai báo remote trong deploy/rclone/rclone.conf – xem README)
RCLONE_REMOTE=
# Xóa bản trên kho ngoài cũ hơn N ngày (0 = không xóa)
RCLONE_KEEP_DAYS=90

# Nhãn phiên bản image (tùy chọn, vd 1.0.0)
APP_VERSION=latest
