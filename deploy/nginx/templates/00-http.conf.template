# =============================================================================
# Cấu hình mức http (được envsubst sinh ra /etc/nginx/conf.d/00-http.conf)
# =============================================================================
server_tokens off;
charset utf-8;

# Ảnh 25 MB + phần form; khu quản trị nâng lên 210m (video) trong vandon-locations.inc
client_max_body_size 30m;
client_body_timeout 120s;
client_body_buffer_size 256k;

# ---- Nén gzip (brotli không có sẵn trong image nginx chính thức; gzip là đủ) ----
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css text/xml application/xml application/rss+xml application/json
           application/javascript text/javascript image/svg+xml application/manifest+json font/ttf;

# ---- Nhật ký: IP thật, thời gian xử lý upstream ----
log_format vandon '$remote_addr - [$time_local] "$host" "$request" $status $body_bytes_sent '
                  '"$http_referer" "$http_user_agent" rt=$request_time urt=$upstream_response_time';
access_log /var/log/nginx/access.log vandon;

# ---- Giới hạn tần suất (TR FR-I06, 8.2) – chỉ áp cho POST ----
map $request_method $limit_post_key {
    POST    $binary_remote_addr;
    default "";
}
# Gửi đánh giá / góp ý: 6 yêu cầu/phút/IP (ứng dụng còn giới hạn SUBMIT_RATE_LIMIT_PER_HOUR)
limit_req_zone $limit_post_key zone=vandon_submit:10m rate=6r/m;
# Đăng nhập quản trị + nhập OTP: 10 yêu cầu/phút/IP (ứng dụng khóa tài khoản sau 5 lần sai)
limit_req_zone $limit_post_key zone=vandon_login:10m rate=10r/m;
# Toàn site: chống quét thô (mọi phương thức)
limit_req_zone $binary_remote_addr zone=vandon_global:20m rate=20r/s;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=vandon_conn:10m;

# ---- Bộ nhớ đệm trình duyệt cho /static/: tệp có mã băm (WhiteNoise Manifest) -> 1 năm, immutable ----
map $uri $vandon_static_cache {
    "~\.[0-9a-f]{12}\.[A-Za-z0-9]+$"  "public, max-age=31536000, immutable";
    default                           "public, max-age=86400";
}

# HSTS chỉ gửi khi đang ở HTTPS (giá trị rỗng -> nginx không thêm header)
map $scheme $vandon_hsts {
    https   "max-age=31536000";
    default "";
}

# Thời gian chờ proxy mặc định (khu quản trị nâng lên 300s)
proxy_connect_timeout 5s;
proxy_send_timeout 120s;
proxy_read_timeout 120s;

# ---- Upstream Django (Gunicorn) ----
# "resolve" + resolver Docker: nginx tự cập nhật IP khi container web được thay (cập nhật không gián đoạn)
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 3s;
upstream vandon_app {
    zone vandon_app 64k;
    server web:8000 resolve max_fails=3 fail_timeout=10s;
    keepalive 16;
}
